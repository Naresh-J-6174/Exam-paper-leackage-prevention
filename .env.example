# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# --- Blockchain (testnet) ---
RPC_URL=https://rpc-amoy.polygon.technology        # or your Alchemy/Infura Amoy/Sepolia URL
BACKEND_PRIVATE_KEY=your-test-wallet-private-key   # same wallet that deployed the contract
CONTRACT_ADDRESS=0xDeployedContractAddressHere

# --- File encryption ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=64-char-hex-string-here
